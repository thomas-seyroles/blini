  "views": {
    "public.point_events": {
      "columns": {
        "id": {
          "name": "id",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "userId": {
          "name": "userId",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "label": {
          "name": "label",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "points": {
          "name": "points",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "at": {
          "name": "at",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n    select 'anecdote:' || a.id as id, a.user_id, 'Anecdote envoyée : ' || a.title as label, 20 as points, a.created_at as at\n    from anecdotes a\n    union all\n    select 'validation:' || a.id, a.user_id, 'Anecdote validée : ' || a.title, 50, a.validated_at\n    from anecdotes a where a.validated_at is not null\n    union all\n    select 'retenue:' || a.id, a.user_id, 'Anecdote retenue par Lunii : ' || a.title, 300, coalesce(a.validated_at, a.created_at)\n    from anecdotes a where a.status >= 2\n    union all\n    select 'trajet:' || b.id, b.passenger_id, 'Trajet effectué : ' || cf.name || ' → ' || ct.name, 20, j.arrive_at\n    from bookings b\n    join journeys j on j.id = b.journey_id\n    join cities cf on cf.slug = j.from_city\n    join cities ct on ct.slug = j.to_city\n    where b.status = 'acceptee' and j.cancelled_at is null and j.arrive_at < now()\n    union all\n    select 'conduite:' || j.id, j.driver_id, 'Trajet conduit : ' || cf.name || ' → ' || ct.name, 30, j.arrive_at\n    from journeys j\n    join cities cf on cf.slug = j.from_city\n    join cities ct on ct.slug = j.to_city\n    where j.cancelled_at is null and j.arrive_at < now()\n    union all\n    select 'item:' || ui.item_id, ui.user_id, 'Échange : ' || i.title, -i.cost_points, ui.created_at\n    from user_items ui join items i on i.id = ui.item_id\n    union all\n    select 'remise:' || b.id, b.passenger_id, 'Points utilisés sur une réservation', -b.points_used, b.created_at\n    from bookings b where b.points_used > 0 and b.status in ('demande', 'acceptee')\n",
      "name": "point_events",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
