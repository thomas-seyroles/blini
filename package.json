{
  "name": "bluni-code",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "next dev -H 0.0.0.0",
    "tunnel": "ngrok http 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/server/db/seed/index.ts",
    "db:studio": "drizzle-kit studio",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.32.1"
}
